# Mapbox public token for the Commute & safety zone map.
# Create one at https://account.mapbox.com/access-tokens/ -- it starts with "pk.".
#
# This one DOES reach the browser (that is what a public token is for), so
# restrict it by URL in the Mapbox dashboard. It is a different key from the
# Google one in ../spike/.env, which is server-side and must never be exposed.
VITE_MAPBOX_TOKEN=

# ---------- accounts ----------
# Sign-in is optional: everything in the app works signed out. These only need
# filling in if you want "Continue with Google" to work.
#
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials -- it is a different
# credential from the Maps key in ../spike/.env.
#
# Register this exact redirect URI on it, matching APP_ORIGIN below:
#   http://localhost:5173/api/auth/google/callback
#
# Both are read by the API process and never reach the browser. (npm run dev:api
# loads this file as well as ../spike/.env, so server-side keys for the web app
# belong here rather than in the scoring engine's own env.)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Where the browser reaches the app. Vite proxies /api, so in dev this is
# Vite's port and not the API's. Set it to the real origin in a deployment --
# the session cookie is marked Secure whenever this is https.
APP_ORIGIN=http://localhost:5173

# ---------- sign-in links ----------
# Sign-in is by emailed link. With no key here the link is printed to the API
# process's console instead of being sent, which is enough to develop against:
# copy it out of the terminal and paste it in the browser.
#
# To send real mail, create a key at https://resend.com/api-keys. Until you
# verify a domain with them, MAIL_FROM must stay their test sender and mail
# only goes to your own Resend account address.
RESEND_API_KEY=
MAIL_FROM=Reality Check <onboarding@resend.dev>

# Accounts live in a SQLite file, created on first run. Override to move it.
# DB_FILE=./data/app.db
