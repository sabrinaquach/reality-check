# Google Maps Platform key. Needs these APIs enabled on the project:
#   - Directions API   (commute)
#   - Places API (New) (amenities + address autocomplete later)
#   - Geocoding API    (fallback geocoder for addresses Census misses)
GOOGLE_MAPS_API_KEY=

# Census API key -- free, instant, no billing: https://api.census.gov/data/key_signup.html
# Used for the cost pillar (ACS 5-year median rent for the listing's tract).
CENSUS_API_KEY=

# Safety scoring needs NO key -- SJPD open data is public.

# RentCast rental listings -- https://app.rentcast.io/app/api
# The free tier is small, so the code caps itself and caches every response to
# disk. Raise the ceiling only if you know your plan allows it.
RENTCAST_API_KEY=
RENTCAST_MONTHLY_CAP=40
